# Copy to .env and adjust. Never commit .env.

# PostgreSQL (docker-compose default)
DATABASE_URL=postgresql+psycopg://jove:jove@localhost:5432/jove

# JWT signing (generate: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# CORS (comma-separated origins; include Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# G-code storage (absolute or relative to cwd)
GCODE_UPLOAD_DIR=data/uploads
GCODE_MAX_UPLOAD_MB=256

# Bootstrap first manager when database has zero users (optional)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-on-first-login

# Home Assistant (optional)
# Credentials can also be entered in Farm → Controls → Home Assistant… (stored in Postgres).
# Tokens saved via the Farm UI are stored in Postgres as plaintext — protect backups and DB access.
HOME_ASSISTANT_BASE_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# Moonraker: HTTP liveness when WebSocket is down (seconds; 0 = disable). Matches manual Sync.
MOONRAKER_HTTP_LIVENESS_INTERVAL_SEC=30

# Tailscale MagicDNS: if the API runs in Docker and printers use names like la-porqueriza,
# start with: docker compose -f docker-compose.yml -f docker-compose.tailscale.yml up -d api
# Or run the API on the host (not in Docker) where Tailscale is installed.
