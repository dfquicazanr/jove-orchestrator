# API base (no trailing slash). For Docker: set in repo root .env — used as build arg for the web image.
VITE_API_URL=http://localhost:8000

# Set to "true" to show static mock printers on Farm (all statuses + spirals) without the API.
# You can also use the URL query ?mockPrinters=1 on /farm.
# VITE_MOCK_PRINTERS=true
